# Hex, at least 32 bytes (openssl rand -hex 32). Keys the blinded subject token; never commit.
TOKEN_PEPPER=
# At least 32 characters; guards /cases (service calls).
SERVICE_API_KEY=
# Staff sign-in is verified against Supabase Auth (the project JWKS).
SUPABASE_JWKS_URL=
# Postgres connection string from Supabase (Project settings > Database); only for npm run db:migrate.
DATABASE_URL=
