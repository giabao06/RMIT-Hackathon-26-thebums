# Send reports to the real backend as well as the in-tab simulation. Leave empty for simulation only.
VITE_API_URL=/api
# An org id from the backend database (orgs table).
VITE_ORG_ID=
# Base64 of the signed ReportRelease policy (contracts/ReportRelease.cs), issued once the Tide team deploys it.
# Empty keeps reports on the simulation path.
VITE_TIDE_RELEASE_POLICY=
