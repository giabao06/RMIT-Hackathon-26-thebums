# Send reports to the real backend as well as the in-tab simulation. Leave empty for simulation only.
VITE_API_URL=/api
# An org id from the backend database (orgs table).
VITE_ORG_ID=
# Supabase Auth (staff sign-in). The publishable key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Demo only: shows one-click demo sign-in buttons. Matches the mock seed password. Never set on a real deployment.
VITE_DEMO_PASSWORD=
